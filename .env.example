# Environment Variables Template
# Generate secure 32-byte hex secrets using: openssl rand -hex 32

JWT_SECRET=<generate with: openssl rand -hex 32>
INTERNAL_SERVICE_SECRET=<generate with: openssl rand -hex 32>

# Infrastructure Endpoints (Default Docker Compose / Local bindings)
MONGO_URI=mongodb://localhost:27017/food_delivery
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:29092

# Gateway & Frontend Ports
FRONTEND_PORT=5173
GATEWAY_PORT=8080
FRONTEND_URL=http://localhost:5173

# Service Ports & Proxy Targets
USER_SERVICE_PORT=4001
RESTAURANT_SERVICE_PORT=4002
ORDER_SERVICE_PORT=4003
AGENT_SERVICE_PORT=4004
NOTIFICATION_SERVICE_PORT=4005

USER_SERVICE_URL=http://localhost:4001
RESTAURANT_SERVICE_URL=http://localhost:4002
ORDER_SERVICE_URL=http://localhost:4003
AGENT_SERVICE_URL=http://localhost:4004
NOTIFICATION_SERVICE_URL=http://localhost:4005
